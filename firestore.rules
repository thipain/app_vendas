rules_version = '2';

// Regras de acesso do App Vendas (multiloja).
// Publicadas com: firebase deploy --only firestore
//
// - Cada loja guarda tudo em /lojas/{loja}/... e só os membros ativos dela
//   (lojas/{loja}/membros/{uid} com ativo=true) leem e gravam esses dados.
// - Loja travada: manualmente (ativa=false) ou por falta de pagamento
//   (hoje > pagoAte + carenciaDias). O app bloqueia na hora; o servidor ainda
//   aceita por 3 dias, para sincronizar vendas feitas offline antes da trava.
// - Mensalidades (pagamentosLojas), avisos e auditoria do sistema: só o dono.
// - Equipe e configurações da loja: só o administrador da loja altera.
// - Dono do sistema (config/sistema): cadastra/bloqueia lojas e acessa todas.
// - Na configuração inicial (sem config/sistema), a conta logada cria o
//   sistema e a primeira loja na mesma gravação.
// - Auditoria só aceita novos registros: nunca é alterada nem apagada.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }
    function caminhoSistema() {
      return /databases/$(database)/documents/config/sistema;
    }
    function dono() {
      return logado() && exists(caminhoSistema()) && (
        get(caminhoSistema()).data.adminInicial == request.auth.uid
        || request.auth.uid in get(caminhoSistema()).data.get('superAdmins', []));
    }
    // Gravação da configuração inicial, que cria config/sistema junto.
    function donoNaConfiguracao() {
      return logado() && !exists(caminhoSistema())
        && existsAfter(caminhoSistema())
        && getAfter(caminhoSistema()).data.adminInicial == request.auth.uid;
    }
    function caminhoMembro(loja) {
      return /databases/$(database)/documents/lojas/$(loja)/membros/$(request.auth.uid);
    }
    function lojaAtiva(loja) {
      let l = get(/databases/$(database)/documents/lojas/$(loja)).data;
      let sincronizacao = duration.value(3, 'd');
      let liberadaManual = l.get('ativa', true) == true
        || (l.get('travadaEm', null) != null
            && request.time < l.travadaEm + sincronizacao);
      let emDia = l.get('pagoAte', null) == null
        || request.time < l.pagoAte
             + duration.value(int(l.get('carenciaDias', 5)), 'd')
             + sincronizacao;
      return liberadaManual && emDia;
    }
    function ativoNa(loja) {
      return logado() && exists(caminhoMembro(loja))
        && get(caminhoMembro(loja)).data.ativo == true
        && lojaAtiva(loja);
    }
    function adminNa(loja) {
      return ativoNa(loja) && get(caminhoMembro(loja)).data.papel == 'admin';
    }
    function acessa(loja) {
      return ativoNa(loja) || dono();
    }
    // Entregador (motoboy): só vê as entregas atribuídas a ele, o próprio
    // ponto e as configurações da loja.
    function entregadorNa(loja) {
      return ativoNa(loja)
        && get(caminhoMembro(loja)).data.papel == 'entregador';
    }
    // Equipe da loja, sem o entregador.
    function equipeNa(loja) {
      return acessa(loja) && !entregadorNa(loja);
    }

    // Cupom público da loja: ativo, dentro da validade e com o mínimo
    // atingido. O valor exato do desconto é conferido pela loja ao aceitar.
    function cupomValido(loja, codigo, subtotal) {
      let c = get(/databases/$(database)/documents/lojasPublicas/$(loja)/cupons/$(codigo)).data;
      return c.ativo == true
        && subtotal >= c.get('minimo', 0)
        && (c.get('validoAte', null) == null || request.time < c.validoAte);
    }

    // Pedido enviado pelo cliente na loja online. Os preços são conferidos de
    // novo pela loja ao aceitar; aqui valida o formato, a loja aberta, a taxa,
    // o pedido mínimo, a forma de pagamento e, no Pix, o comprovante anexado
    // na mesma gravação.
    function pedidoOnlineValido(loja, id) {
      let d = request.resource.data;
      let pub = get(/databases/$(database)/documents/lojasPublicas/$(loja)).data;
      return logado()
        && lojaAtiva(loja)
        && pub.get('ativa', false) == true
        && pub.get('aberta', false) == true
        && d.keys().hasOnly(['clienteUid', 'clienteNome', 'telefone', 'cep',
             'endereco', 'bairro', 'referencia', 'observacao', 'itens',
             'subtotal', 'taxaEntrega', 'total', 'formaPagamento',
             'trocoPara', 'temComprovante', 'maiorIdade', 'status',
             'criadoEm', 'cupom', 'desconto'])
        && d.clienteUid == request.auth.uid
        && d.status == 'aguardando'
        && d.criadoEm == request.time
        && d.maiorIdade == true
        && d.clienteNome is string && d.clienteNome.size() > 0
        && d.clienteNome.size() <= 100
        && d.telefone is string && d.telefone.size() >= 8
        && d.telefone.size() <= 30
        && d.cep is string && d.cep.size() <= 9
        && d.endereco is string && d.endereco.size() > 0
        && d.endereco.size() <= 200
        && d.bairro is string && d.bairro.size() <= 80
        && d.referencia is string && d.referencia.size() <= 200
        && d.observacao is string && d.observacao.size() <= 300
        && d.itens is list && d.itens.size() > 0 && d.itens.size() <= 50
        && d.subtotal is number && d.total is number
        && d.subtotal >= pub.get('pedidoMinimo', 0)
        && d.taxaEntrega == pub.get('taxaEntrega', 0)
        && d.formaPagamento in pub.get('formas', [])
        && (d.trocoPara == null || d.trocoPara is number)
        && ((d.get('cupom', null) == null && d.get('desconto', 0) == 0)
            || (d.get('cupom', null) is string
                && cupomValido(loja, d.cupom, d.subtotal)
                && d.desconto is number && d.desconto > 0
                && d.desconto <= d.subtotal))
        && (d.formaPagamento != 'Pix'
            || (d.temComprovante == true
                && existsAfter(/databases/$(database)/documents/lojas/$(loja)/pedidosOnline/$(id)/anexos/comprovante)))
        && getAfter(/databases/$(database)/documents/lojas/$(loja)/limitesOnline/$(request.auth.uid))
             .data.ultimoPedido == request.time;
    }

    match /config/sistema {
      allow read: if logado();
      allow create: if logado()
        && request.resource.data.adminInicial == request.auth.uid;
      allow update: if dono();
      allow delete: if false;
    }

    // E-mail → uid e a loja em que a conta está (uma loja ativa por vez).
    // O administrador de uma loja só vincula contas livres (lojaId nulo) à
    // própria loja; o dono do sistema altera qualquer uma.
    match /contas/{email} {
      allow read: if logado();
      allow create: if logado();
      allow update: if dono()
        || (request.resource.data.uid == resource.data.uid
            && resource.data.get('lojaId', null) == null
            && adminNa(request.resource.data.lojaId));
      allow delete: if false;
    }

    match /auditoriaSistema/{id} {
      allow read, create: if dono();
      allow update, delete: if false;
    }

    match /pagamentosLojas/{id} {
      allow read, create: if dono();
      allow update, delete: if false;
    }

    // Erros enviados pelos aparelhos; só o dono do sistema lê e apaga.
    match /errosApp/{id} {
      allow create: if logado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.mensagem is string
        && request.resource.data.mensagem.size() <= 1000
        && request.resource.data.stack.size() <= 4000;
      allow read, delete: if dono();
      allow update: if false;
    }

    // Avisos do dono do sistema para as lojas.
    match /avisos/{id} {
      allow read: if logado();
      allow write: if dono();
    }

    match /lojas/{loja} {
      allow read: if acessa(loja) || (logado() && exists(caminhoMembro(loja)));
      allow create: if dono() || donoNaConfiguracao();
      allow update: if dono();
      // Excluir a loja (cliente que encerrou o contrato): só o dono.
      allow delete: if dono();

      match /membros/{uid} {
        allow read: if acessa(loja) || (logado() && request.auth.uid == uid);
        allow create: if adminNa(loja) || dono() || donoNaConfiguracao();
        // O próprio usuário só altera o nome; o resto é com o administrador.
        allow update: if adminNa(loja) || dono()
          || (ativoNa(loja) && request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['nome', 'nomeBusca', 'atualizadoEm']));
        allow delete: if dono();
      }

      match /config/{doc} {
        allow read: if acessa(loja);
        allow write: if adminNa(loja) || dono();
      }

      match /auditoria/{id} {
        allow read, create: if acessa(loja);
        allow update: if false;
        allow delete: if dono();
      }

      match /{colecao}/{id} {
        allow read, write: if equipeNa(loja) && colecao in [
          'produtos', 'clientes', 'vendas', 'caixas', 'movimentosCaixa',
          'comandas', 'movimentosEstoque', 'notasEntrada', 'receitas',
          'operacoesEstoque', 'retiradas', 'ponto', 'pedidos', 'motoboys',
          'fechamentosMotoboys', 'pedidosOnline', 'cupons'
        ];
      }

      // Pedidos feitos pelo cliente na loja online (login anônimo). A equipe
      // lê e altera pela regra geral acima; o cliente só cria e acompanha o
      // próprio pedido.
      match /pedidosOnline/{id} {
        allow create: if pedidoOnlineValido(loja, id);
        allow get: if logado()
          && resource.data.clienteUid == request.auth.uid;

        // Comprovante do Pix: enviado pelo cliente junto com o pedido.
        match /anexos/{anexo} {
          allow create: if logado() && anexo == 'comprovante'
            && getAfter(/databases/$(database)/documents/lojas/$(loja)/pedidosOnline/$(id))
                 .data.clienteUid == request.auth.uid
            && request.resource.data.keys().hasOnly(['imagem', 'clienteUid'])
            && request.resource.data.clienteUid == request.auth.uid
            && request.resource.data.imagem is string
            && request.resource.data.imagem.size() <= 900000;
          allow read, delete: if equipeNa(loja);
        }
      }

      // Último pedido online de cada cliente: no máximo um a cada 2 minutos.
      match /limitesOnline/{uid} {
        allow read: if (logado() && request.auth.uid == uid) || dono();
        // Exclusão da loja pelo dono do sistema.
        allow delete: if dono();
        allow create, update: if logado() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['ultimoPedido'])
          && request.resource.data.ultimoPedido == request.time
          && (resource == null
              || resource.data.ultimoPedido + duration.value(2, 'm')
                   < request.time);
      }

      // O entregador registra o próprio ponto.
      match /ponto/{id} {
        allow read: if entregadorNa(loja)
          && resource.data.usuarioId == request.auth.uid;
        allow create: if entregadorNa(loja)
          && request.resource.data.usuarioId == request.auth.uid;
      }

      // Pedidos de delivery: o entregador lê os atribuídos a ele e só pode
      // marcar como entregue um pedido em rota.
      match /pedidos/{id} {
        allow read: if entregadorNa(loja)
          && resource.data.entregadorId == request.auth.uid;
        allow update: if entregadorNa(loja)
          && resource.data.entregadorId == request.auth.uid
          && resource.data.status == 'em_rota'
          && request.resource.data.status == 'entregue'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'entregueEm', 'localEntrega']);

        // Comprovante do Pix: só a equipe da loja.
        match /anexos/{anexo} {
          allow read, delete: if equipeNa(loja);
          allow create, update: if equipeNa(loja)
            && request.resource.data.imagem is string
            && request.resource.data.imagem.size() <= 900000;
        }
      }
    }

    // Loja online: dados públicos (cardápio, taxa, formas de pagamento),
    // lidos pela página do cliente sem login de funcionário.
    match /lojasPublicas/{loja} {
      allow read: if true;
      allow write: if equipeNa(loja) || dono();
      match /cardapio/{doc} {
        allow read: if true;
        allow write: if equipeNa(loja) || dono();
      }
      // Cupons: a página consulta pelo código digitado, sem listar todos.
      // O dono do sistema lista para apagar junto com a loja.
      match /cupons/{codigo} {
        allow get: if true;
        allow list: if dono();
        allow write: if equipeNa(loja) || dono();
      }
    }

    // Link da loja online → id da loja. Só o administrador reserva.
    match /slugs/{slug} {
      allow get: if true;
      allow list: if false;
      allow create: if (adminNa(request.resource.data.lojaId) || dono())
        && request.resource.data.keys().hasOnly(['lojaId']);
      allow delete: if adminNa(resource.data.lojaId) || dono();
      allow update: if false;
    }

    // Consulta "em quais lojas eu trabalho" (collection group de membros).
    match /{caminho=**}/membros/{uid} {
      allow read: if logado() && resource.data.uid == request.auth.uid;
    }

    // Dados da versão anterior às lojas: só o dono do sistema lê, para migrar.
    match /config/loja {
      allow read: if dono();
    }
    match /{colecao}/{id} {
      allow read: if dono() && colecao in [
        'produtos', 'clientes', 'vendas', 'caixas', 'movimentosCaixa',
        'comandas', 'movimentosEstoque', 'notasEntrada', 'receitas',
        'operacoesEstoque', 'retiradas', 'ponto', 'auditoria', 'usuarios'
      ];
    }
  }
}
