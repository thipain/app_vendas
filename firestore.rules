rules_version = '2';

// Regras de acesso do App Vendas.
// Publicadas com: firebase deploy --only firestore (ou cole no Console >
// Firestore Database > Regras).
//
// - Só membros ativos da equipe (documento em /usuarios/{uid} com ativo=true)
//   leem e gravam os dados da loja.
// - Equipe, permissões e configurações da loja só o administrador altera.
// - No primeiro acesso (sem /config/sistema), a conta logada pode se
//   cadastrar como administrador.
// - A auditoria só aceita novos registros: nunca é alterada nem apagada.
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function ativo() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().ativo == true;
    }
    function admin() {
      return ativo() && perfil().papel == 'admin';
    }
    function semAdministrador() {
      return !exists(/databases/$(database)/documents/config/sistema);
    }

    match /usuarios/{uid} {
      allow read: if ativo() || (logado() && request.auth.uid == uid);
      allow create: if admin()
        || (logado() && request.auth.uid == uid && semAdministrador()
            && request.resource.data.papel == 'admin'
            && request.resource.data.ativo == true);
      // O próprio usuário só altera o nome; o resto é com o administrador.
      allow update: if admin()
        || (ativo() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['nome', 'nomeBusca', 'atualizadoEm']));
      allow delete: if false;
    }

    match /config/sistema {
      allow read: if logado();
      allow create: if logado() && semAdministrador();
      allow update, delete: if false;
    }

    match /config/{doc} {
      allow read: if ativo();
      allow write: if admin();
    }

    match /auditoria/{id} {
      allow read: if ativo();
      allow create: if ativo();
      allow update, delete: if false;
    }

    match /{colecao}/{id} {
      allow read, write: if ativo() && colecao in [
        'produtos', 'clientes', 'vendas', 'caixas', 'movimentosCaixa',
        'comandas', 'movimentosEstoque', 'notasEntrada', 'receitas',
        'operacoesEstoque', 'retiradas', 'ponto'
      ];
    }
  }
}
